<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="iti_track_list_view" model="ir.ui.view">
            <field name="name">iti.track.list</field>
            <field name="model">iti.track</field>
            <field name="arch" type="xml">
                <list>
                    <field name="title"/>

                </list>
            </field>
        </record>

        <record id="iti_track_form_view" model="ir.ui.view">
            <field name="name">iti.track.form</field>
            <field name="model">iti.track</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="title"/>
                            <field name="student_ids" widget="many2many_tags"/>
                            <field name="duration"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_iti_track" model="ir.actions.act_window">
            <field name="name">ITI track</field>
            <field name="res_model">iti.track</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_iti_track" name="ITI track" parent="menu_school_management_root"
                  action="action_iti_track" sequence="2"/>

    </data>
</odoo>