<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--        category-->
        <record model="ir.module.category" id="module_category_school_management">
            <field name="name">School Management</field>
            <field name="sequence">20</field>
        </record>
        <!--privilege-->
        <record model="res.groups.privilege" id="res_groups_privilege_school_management">
            <field name="name">School Management</field>
            <field name="category_id" ref="module_category_school_management"/>
        </record>
        <!--groups-->
        <record id="group_user_school_management" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_groups_privilege_school_management"/>
            <!--            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>-->
        </record>

        <record id="group_manager_school_management" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_school_management"/>
            <field name="implied_ids" eval="[(4, ref('school_management.group_user_school_management'))]"/>
        </record>

        <!--        record rules-->
        <record id="school_management_rule_user" model="ir.rule">
            <field name="name">school management rule user</field>
            <field ref="model_iti_student" name="model_id"/>
            <field name="domain_force">['|',('create_uid','=',user.id),('create_uid','=',False)]</field>
            <field name="groups" eval="[(4, ref('school_management.group_user_school_management'))]"/>
        </record>

        <record id="school_management_rule_manager" model="ir.rule">
            <field name="name">school management rule manager</field>
            <field ref="model_iti_student" name="model_id"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('school_management.group_manager_school_management'))]"/>
        </record>


    </data>
</odoo>