<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="create_track_form_view" model="ir.ui.view">
            <field name="name">create.track.form</field>
            <field name="model">create.track</field>
            <field name="arch" type="xml">
                <form string="ModelTitle">
                    <sheet>
                        <group>
                            <group>
                                <field name="title"/>
                            </group>
                            <group>
                                <field name="duration"/>
                            </group>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_create_track" string="Create" type="object" class="oe_highlight"/>
                        <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>


        <record id="create_track_act_window" model="ir.actions.act_window">
            <field name="name">Create Track</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">create.track</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>


    </data>
</odoo>